<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b0e14" />
  <meta name="description" content="Apply for remote AI training jobs. Work from anywhere and get paid in USD. One-time $15 lifetime application fee." />
  <title>AI Trainer Hub — Remote AI Training Jobs</title>

  <style>
    /* =========================================================
       DESIGN TOKENS
       ========================================================= */
    :root {
      --bg:        #0b0e14;
      --surface:   #131720;
      --surface-2: #1a1f2b;
      --border:    #252b3a;
      --text:      #e8ecf4;
      --muted:     #8b95a8;
      --accent:    #5b8cff;
      --accent-2:  #7c5cff;
      --success:   #34d399;
      --danger:    #f87171;
      --radius:    16px;
      --radius-sm: 10px;
      --shadow:    0 8px 32px rgba(0, 0, 0, 0.45);
      --font: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    }

    /* =========================================================
       RESET & BASE
       ========================================================= */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    a { color: var(--accent); text-decoration: none; }
    img { max-width: 100%; display: block; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 4px;
    }

    /* =========================================================
       UTILITIES
       ========================================================= */
    .container { width: min(1120px, 92%); margin-inline: auto; }
    .section { padding: 88px 0; }
    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--accent);
      background: rgba(91, 140, 255, 0.1);
      padding: 6px 14px; border-radius: 999px; margin-bottom: 18px;
    }

    .section-title {
      font-size: clamp(1.6rem, 3.2vw, 2.4rem);
      font-weight: 800; letter-spacing: -0.02em; line-height: 1.2;
      margin-bottom: 12px;
    }

    .section-sub {
      color: var(--muted); font-size: 1.05rem;
      max-width: 560px; margin-bottom: 40px;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 11px 22px; border-radius: var(--radius-sm);
      font-size: 0.9rem; font-weight: 600;
      transition: transform 0.18s ease, box-shadow 0.18s ease,
                  background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff;
      box-shadow: 0 4px 20px rgba(91, 140, 255, 0.35);
    }
    .btn-primary:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 6px 26px rgba(91, 140, 255, 0.5);
    }
    .btn-primary:disabled {
      opacity: 0.65;
      cursor: not-allowed;
      box-shadow: none;
    }

    .btn-ghost {
      background: transparent; color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { background: var(--surface-2); border-color: var(--accent); }

    .btn-full { width: 100%; }

    /* =========================================================
       HEADER / NAVIGATION
       ========================================================= */
    header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(11, 14, 20, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      position: relative;
      display: flex; align-items: center; justify-content: space-between;
      height: 68px;
    }

    .logo {
      display: flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 1.15rem; letter-spacing: -0.02em;
      color: var(--text);
    }
    .logo-mark {
      width: 34px; height: 34px; border-radius: 9px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      display: grid; place-items: center;
      font-size: 0.85rem; color: #fff; font-weight: 800;
    }

    .nav-links { display: flex; gap: 28px; align-items: center; }
    .nav-links a {
      color: var(--muted); font-size: 0.9rem; font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }

    .menu-toggle {
      display: none;
      width: 42px; height: 42px; border-radius: var(--radius-sm);
      border: 1px solid var(--border); background: var(--surface);
      color: var(--text); font-size: 1.15rem;
      align-items: center; justify-content: center;
    }

    /* =========================================================
       HERO
       ========================================================= */
    .hero { padding: 100px 0 60px; position: relative; overflow: hidden; }
    .hero::before {
      content: '';
      position: absolute; top: -160px; left: 50%; transform: translateX(-50%);
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(91, 140, 255, 0.12), transparent 65%);
      pointer-events: none;
    }

    .hero-inner { position: relative; text-align: center; max-width: 780px; margin-inline: auto; }

    .hero h1 {
      font-size: clamp(2.2rem, 5.2vw, 3.8rem);
      font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
      margin-bottom: 20px;
    }
    .grad {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }

    .hero p {
      color: var(--muted); font-size: 1.12rem;
      max-width: 600px; margin: 0 auto 36px;
    }

    .hero-actions {
      display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
      margin-bottom: 56px;
    }

    .stats {
      display: flex; gap: 40px; justify-content: center; flex-wrap: wrap;
      padding: 28px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .stat { text-align: center; }
    .stat-val { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
    .stat-label { color: var(--muted); font-size: 0.85rem; margin-top: 2px; }

    /* =========================================================
       JOB LISTINGS
       ========================================================= */
    .jobs-grid { display: grid; gap: 16px; }

    .job-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px;
      transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }
    .job-card:hover {
      border-color: rgba(91, 140, 255, 0.4);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }

    .job-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .job-top { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .job-role { font-size: 1.12rem; font-weight: 700; letter-spacing: -0.01em; }

    .job-badge {
      font-size: 0.7rem; font-weight: 600;
      padding: 3px 10px; border-radius: 999px;
      background: rgba(91, 140, 255, 0.12); color: var(--accent);
      white-space: nowrap;
    }
    .job-badge.hot { background: rgba(52, 211, 153, 0.12); color: var(--success); }

    .job-meta {
      display: flex; gap: 18px; flex-wrap: wrap;
      color: var(--muted); font-size: 0.85rem;
    }
    .job-desc { color: var(--muted); font-size: 0.9rem; max-width: 620px; }

    .job-side {
      display: flex; flex-direction: column;
      align-items: flex-end; justify-content: center;
      gap: 10px; min-width: 140px;
    }
    .job-pay {
      font-size: 1.25rem; font-weight: 800;
      color: var(--success); white-space: nowrap;
    }
    .job-pay small { font-size: 0.7rem; font-weight: 500; color: var(--muted); }

    .btn-apply {
      background: var(--surface-2); color: var(--text);
      border: 1px solid var(--border);
      font-size: 0.82rem; padding: 9px 18px;
      border-radius: var(--radius-sm); font-weight: 600;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .btn-apply:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

    /* =========================================================
       HOW IT WORKS
       ========================================================= */
    .how-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }
    .step {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
    }
    .step-num {
      width: 38px; height: 38px; border-radius: 10px;
      background: rgba(91, 140, 255, 0.12); color: var(--accent);
      display: grid; place-items: center;
      font-weight: 800; font-size: 1rem;
      margin-bottom: 16px;
    }
    .step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
    .step p { color: var(--muted); font-size: 0.88rem; }

    /* =========================================================
       APPLY SECTION
       ========================================================= */
    .apply-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .apply-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }

    .apply-info h2 {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 800; margin-bottom: 16px; letter-spacing: -0.02em;
    }
    .apply-info > p {
      color: var(--muted); margin-bottom: 28px; max-width: 460px;
    }

    .fee-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
    }
    .fee-row {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; padding: 10px 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
    }
    .fee-row:last-child { border-bottom: none; }
    .fee-row.total { font-weight: 800; font-size: 1.1rem; padding-top: 14px; }
    .fee-row .price { color: var(--success); font-weight: 700; white-space: nowrap; }
    .fee-note { color: var(--muted); font-size: 0.78rem; margin-top: 12px; }

    /* ----- Form ----- */
    .form-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
    }
    .form-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; }
    .form-card .sub { color: var(--muted); font-size: 0.85rem; margin-bottom: 24px; }

    .field { margin-bottom: 18px; }
    .field label {
      display: block; font-size: 0.82rem; font-weight: 600;
      margin-bottom: 6px; color: var(--text);
    }
    .field input,
    .field select {
      width: 100%;
      padding: 12px 14px;
      font-size: 0.92rem;
      font-family: inherit;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--text);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .field input::placeholder { color: #5a6478; }
    .field input:focus,
    .field select:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(91, 140, 255, 0.15);
    }
    .field input[aria-invalid="true"],
    .field select[aria-invalid="true"] {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.12);
    }

    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .form-disclaimer {
      color: var(--muted); font-size: 0.75rem;
      margin-top: 14px; text-align: center;
    }

    .form-msg {
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      margin-top: 14px;
      display: none;
    }
    .form-msg.error {
      display: block;
      background: rgba(248, 113, 113, 0.1);
      color: var(--danger);
      border: 1px solid rgba(248, 113, 113, 0.25);
    }
    .form-msg.success {
      display: block;
      background: rgba(52, 211, 153, 0.1);
      color: var(--success);
      border: 1px solid rgba(52, 211, 153, 0.25);
    }

    /* =========================================================
       FOOTER
       ========================================================= */
    footer { padding: 48px 0; border-top: 1px solid var(--border); }
    .footer-inner {
      display: flex; justify-content: space-between;
      align-items: center; flex-wrap: wrap; gap: 20px;
    }
    .footer-inner p { color: var(--muted); font-size: 0.82rem; }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a { color: var(--muted); font-size: 0.82rem; }
    .footer-links a:hover { color: var(--text); }

    /* =========================================================
       TOAST
       ========================================================= */
    .toast {
      position: fixed; bottom: 28px; left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--success); color: #042f1e;
      font-weight: 700; font-size: 0.88rem;
      padding: 14px 28px; border-radius: 999px;
      box-shadow: var(--shadow);
      opacity: 0; pointer-events: none;
      transition: opacity 0.35s ease, transform 0.35s ease;
      z-index: 200;
      max-width: 92vw; text-align: center;
    }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */
    @media (max-width: 820px) {
      .menu-toggle { display: inline-flex; }

      .nav > .btn-primary { display: none; }

      .nav-links {
        display: none;
        position: absolute; top: 100%; left: 0; right: 0;
        flex-direction: column; gap: 0;
        padding: 8px 0;
        background: rgba(19, 23, 32, 0.98);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow);
      }
      .nav-links.open { display: flex; }
      .nav-links a { width: 100%; padding: 14px 24px; font-size: 0.95rem; }

      .apply-grid { grid-template-columns: 1fr; gap: 36px; }

      .job-card { grid-template-columns: 1fr; }
      .job-side {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }

      .hero { padding: 70px 0 40px; }
      .section { padding: 64px 0; }
    }

    @media (max-width: 560px) {
      .field-row { grid-template-columns: 1fr; }
      .stats { gap: 24px; }
      .stat-val { font-size: 1.4rem; }
      .form-card { padding: 24px; }
      .fee-box { padding: 20px; }
    }

    /* =========================================================
       REDUCED MOTION
       ========================================================= */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

  <!-- =========================================================
       HEADER
       ========================================================= -->
  <header>
    <div class="container nav">
      <a href="#" class="logo" aria-label="AI Trainer Hub home">
        <span class="logo-mark" aria-hidden="true">AI</span>
        Trainer Hub
      </a>

      <nav class="nav-links" id="navLinks" aria-label="Main navigation">
        <a href="#jobs">Jobs</a>
        <a href="#how">How it works</a>
        <a href="#apply">Apply</a>
      </nav>

      <a href="#apply" class="btn btn-primary">Apply now</a>

      <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="navLinks"
      >☰</button>
    </div>
  </header>

  <!-- =========================================================
       HERO
       ========================================================= -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">● Remote · USD pay · Flexible hours</span>
      <h1>Train the next generation of <span class="grad">AI models</span> from anywhere.</h1>
      <p>Real remote AI training jobs. Work on your schedule, get paid in US dollars, and help shape the future of AI. One simple $15 application fee.</p>

      <div class="hero-actions">
        <a href="#jobs" class="btn btn-primary">Browse jobs</a>
        <a href="#how" class="btn btn-ghost">How it works</a>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="stat-val"><span class="grad">3,400+</span></div>
          <div class="stat-label">Open roles</div>
        </div>
        <div class="stat">
          <div class="stat-val"><span class="grad">$15–$80</span></div>
          <div class="stat-label">Hourly pay range</div>
        </div>
        <div class="stat">
          <div class="stat-val"><span class="grad">100%</span></div>
          <div class="stat-label">Remote</div>
        </div>
        <div class="stat">
          <div class="stat-val"><span class="grad">$15</span></div>
          <div class="stat-label">One-time fee</div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       JOB LISTINGS
       ========================================================= -->
  <section class="section" id="jobs">
    <div class="container">
      <span class="eyebrow">Live opportunities</span>
      <h2 class="section-title">Remote AI training jobs</h2>
      <p class="section-sub">Realistic roles from real AI training platforms. Pay rates are in USD and based on advertised hourly ranges.</p>

      <div class="jobs-grid" id="jobGrid">
        <!-- Job cards injected by JavaScript -->
      </div>
    </div>
  </section>

  <!-- =========================================================
       HOW IT WORKS
       ========================================================= -->
  <section class="section how-section" id="how">
    <div class="container">
      <span class="eyebrow">Simple process</span>
      <h2 class="section-title">How it works</h2>
      <p class="section-sub">Three steps from application to your first paid task.</p>

      <div class="steps">
        <div class="step">
          <div class="step-num" aria-hidden="true">1</div>
          <h3>Pick a role</h3>
          <p>Browse remote AI training jobs that match your background — from generalist data annotation to domain-expert evaluation.</p>
        </div>
        <div class="step">
          <div class="step-num" aria-hidden="true">2</div>
          <h3>Submit your details</h3>
          <p>Fill in your name, email, and phone number. We use this to match you with the right project team.</p>
        </div>
        <div class="step">
          <div class="step-num" aria-hidden="true">3</div>
          <h3>Pay $15 &amp; get started</h3>
          <p>Your one-time $15 application fee activates your profile. Once verified, you can start applying to live tasks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       APPLY SECTION
       ========================================================= -->
  <section class="section apply-section" id="apply">
    <div class="container apply-grid">

      <!-- Left: fee info -->
      <div class="apply-info">
        <span class="eyebrow">Get started</span>
        <h2>Apply once. Get matched with real work.</h2>
        <p>Your $15 lifetime application fee covers profile verification and matching. No subscriptions, no hidden charges. Pay once and you're in.</p>

        <div class="fee-box">
          <div class="fee-row">
            <span>Profile verification &amp; matching</span>
            <span class="price">$15.00</span>
          </div>
          <div class="fee-row">
            <span>Lifetime access</span>
            <span class="price">Included</span>
          </div>
          <div class="fee-row">
            <span>No recurring charges</span>
            <span class="price">Included</span>
          </div>
          <div class="fee-row total">
            <span>Total due today</span>
            <span class="price">$15.00 USD</span>
          </div>
        </div>
        <p class="fee-note">One-time payment. Secure checkout via Stripe. You will be redirected to Stripe's hosted checkout page to complete payment.</p>
      </div>

      <!-- Right: application form -->
      <div class="form-card">
        <h3>Your application</h3>
        <p class="sub">Tell us who you are. All fields are required.</p>

        <form id="applyForm" novalidate>
          <div class="field">
            <label for="fullName">Full name</label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              placeholder="e.g. Alex Johnson"
              autocomplete="name"
              maxlength="80"
              required
            />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email address</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                autocomplete="email"
                inputmode="email"
                maxlength="254"
                required
              />
            </div>

            <div class="field">
              <label for="phone">Phone number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+1 555 000 1234"
                autocomplete="tel"
                inputmode="tel"
                maxlength="20"
                required
              />
            </div>
          </div>

          <div class="field">
            <label for="role">Role you're applying for</label>
            <select id="role" name="role" required>
              <option value="" disabled selected>Select a role…</option>
              <option value="Generalist AI Data Annotator">Generalist AI Data Annotator</option>
              <option value="AI Response Reviewer / Rater">AI Response Reviewer / Rater</option>
              <option value="Domain Expert — STEM / Math">Domain Expert — STEM / Math</option>
              <option value="Coding &amp; Software Engineering Trainer">Coding &amp; Software Engineering Trainer</option>
              <option value="Legal / Medical / Finance Evaluator">Legal / Medical / Finance Evaluator</option>
              <option value="Multilingual AI Quality Analyst">Multilingual AI Quality Analyst</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-full" id="payBtn">
            Pay $15 &amp; submit application
          </button>

          <p class="form-disclaimer">
            By applying you agree to our terms. Your $15 fee is a one-time lifetime application fee.
          </p>

          <div
            class="form-msg"
            id="formMsg"
            role="status"
            aria-live="polite"
          ></div>
        </form>
      </div>

    </div>
  </section>

  <!-- =========================================================
       FOOTER
       ========================================================= -->
  <footer>
    <div class="container footer-inner">
      <p>&copy; 2026 AI Trainer Hub. All rights reserved.</p>
      <div class="footer-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#">Contact</a>
      </div>
    </div>
  </footer>

  <!-- =========================================================
       TOAST
       ========================================================= -->
  <div class="toast" id="toast" role="status" aria-live="polite">
    Application submitted successfully!
  </div>

  <!-- =========================================================
       JAVASCRIPT
       ========================================================= -->
  <script>
    'use strict';

    /* =========================================================
       1. REALISTIC JOB DATA
       Based on advertised pay ranges from AI training platforms
       (Mercor, Outlier, Alignerr, OpenTrain AI, Invisible, etc.)
       ========================================================= */
    const JOBS = [
      {
        role: 'Generalist AI Data Annotator',
        badge: 'Entry level',
        type: 'Part-time · Contract',
        location: 'Remote (Worldwide)',
        pay: '$15–$25',
        period: '/hr',
        desc: 'Label text, images, and short clips to help improve AI model accuracy. No prior experience required — training provided.'
      },
      {
        role: 'AI Response Reviewer / Rater',
        badge: 'Hot',
        type: 'Flexible hours',
        location: 'Remote (Global)',
        pay: '$20–$36',
        period: '/hr',
        desc: 'Review AI-generated answers for accuracy, safety, and reasoning quality. Provide structured written feedback to model developers.'
      },
      {
        role: 'Coding & Software Engineering Trainer',
        badge: 'Expert',
        type: 'Contract · 20+ hrs/wk',
        location: 'Remote (Worldwide)',
        pay: '$65',
        period: '/hr median',
        desc: 'Evaluate code solutions, write reference implementations, and rate AI coding outputs. Ideal for developers with 2+ years of experience.'
      },
      {
        role: 'Domain Expert — STEM / Math',
        badge: 'Expert',
        type: 'Contract · Flexible',
        location: 'Remote (Global)',
        pay: '$60–$120',
        period: '/hr',
        desc: 'Solve and grade advanced math and science problems used to train reasoning models. MSc or PhD preferred; strong undergraduates considered.'
      },
      {
        role: 'Legal / Medical / Finance Evaluator',
        badge: 'Premium',
        type: 'Part-time · Remote',
        location: 'Remote (Worldwide)',
        pay: '$40–$80',
        period: '/hr',
        desc: 'Apply professional domain knowledge to assess AI outputs in law, medicine, or finance. Licensed practitioners and graduate students welcome.'
      },
      {
        role: 'Multilingual AI Quality Analyst',
        badge: 'Language',
        type: 'Freelance · 10–30 hrs/wk',
        location: 'Remote (Global)',
        pay: '$25–$50',
        period: '/hr',
        desc: 'Review AI translations and multilingual outputs for fluency and cultural accuracy. Fluent in English plus one of: Spanish, French, German, Arabic, or Mandarin.'
      }
    ];

    /* =========================================================
       2. DOM REFERENCES
       ========================================================= */
    const jobGrid    = document.getElementById('jobGrid');
    const form       = document.getElementById('applyForm');
    const formMsg    = document.getElementById('formMsg');
    const payBtn     = document.getElementById('payBtn');
    const toast      = document.getElementById('toast');
    const menuToggle = document.getElementById('menuToggle');
    const navLinks   = document.getElementById('navLinks');

    const fullNameEl = document.getElementById('fullName');
    const emailEl    = document.getElementById('email');
    const phoneEl    = document.getElementById('phone');
    const roleEl     = document.getElementById('role');

    let isSubmitting = false;

    /* =========================================================
       3. MOBILE MENU
       ========================================================= */
    function closeMenu() {
      navLinks.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
    }

    menuToggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });

    navLinks.addEventListener('click', (e) => {
      if (e.target.closest('a')) closeMenu();
    });

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav')) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    /* =========================================================
       4. RENDER JOB CARDS
       ========================================================= */
    function renderJobs() {
      jobGrid.innerHTML = JOBS.map((job) => {
        const isHot = job.badge === 'Hot';
        return `
          <article class="job-card">
            <div class="job-main">
              <div class="job-top">
                <span class="job-role">${job.role}</span>
                <span class="job-badge${isHot ? ' hot' : ''}">${job.badge}</span>
              </div>
              <div class="job-meta">
                <span>📍 ${job.location}</span>
                <span>🕒 ${job.type}</span>
              </div>
              <p class="job-desc">${job.desc}</p>
            </div>
            <div class="job-side">
              <div class="job-pay">${job.pay} <small>${job.period}</small></div>
              <button
                type="button"
                class="btn-apply"
                data-role="${job.role}"
                aria-label="Apply for ${job.role}"
              >Apply</button>
            </div>
          </article>
        `;
      }).join('');
    }

    renderJobs();

    /* =========================================================
       5. JOB APPLY BUTTON → SCROLL + PRESELECT ROLE
       ========================================================= */
    jobGrid.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-apply');
      if (!btn) return;

      const roleName = btn.dataset.role || '';
      const match = Array.from(roleEl.options).find(
        (opt) => opt.value === roleName
      );

      if (match) {
        roleEl.value = match.value;
        roleEl.removeAttribute('aria-invalid');
      }

      document.getElementById('apply').scrollIntoView({ behavior: 'smooth' });
    });

    /* =========================================================
       6. FORM HELPERS
       ========================================================= */
    function showMessage(text, type) {
      formMsg.textContent = text;
      formMsg.className = 'form-msg ' + type;
    }

    function clearMessage() {
      formMsg.textContent = '';
      formMsg.className = 'form-msg';
    }

    function setInvalid(el, invalid) {
      if (invalid) {
        el.setAttribute('aria-invalid', 'true');
      } else {
        el.removeAttribute('aria-invalid');
      }
    }

    function showToast(text) {
      toast.textContent = text;
      toast.classList.add('show');
      window.clearTimeout(showToast._timer);
      showToast._timer = window.setTimeout(() => {
        toast.classList.remove('show');
      }, 4500);
    }

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function validateForm() {
      const fullName = fullNameEl.value.trim();
      const email    = emailEl.value.trim();
      const phone    = phoneEl.value.trim();
      const role     = roleEl.value;

      let valid = true;

      // Name
      if (fullName.length < 2) {
        setInvalid(fullNameEl, true);
        valid = false;
      } else {
        setInvalid(fullNameEl, false);
      }

      // Email
      if (!EMAIL_RE.test(email)) {
        setInvalid(emailEl, true);
        valid = false;
      } else {
        setInvalid(emailEl, false);
      }

      // Phone: digits only length 7–15
      const digits = phone.replace(/\D/g, '');
      if (digits.length < 7 || digits.length > 15) {
        setInvalid(phoneEl, true);
        valid = false;
      } else {
        setInvalid(phoneEl, false);
      }

      // Role
      if (!role) {
        setInvalid(roleEl, true);
        valid = false;
      } else {
        setInvalid(roleEl, false);
      }

      return valid;
    }

    /* =========================================================
       7. FORM SUBMISSION + STRIPE CHECKOUT
       ---------------------------------------------------------
       ⚠️ PRODUCTION NOTE:
       This is a front-end DEMO. In production you MUST create the
       Stripe Checkout Session on your server using your secret key.
       Never expose your Stripe secret key in front-end code.

       Required backend endpoint (example):

         POST /api/create-checkout-session
         body: { fullName, email, phone, role }
         returns: { url: "https://checkout.stripe.com/..." }

       Server-side (Node.js example):

         const session = await stripe.checkout.sessions.create({
           mode: 'payment',
           line_items: [{
             price_data: {
               currency: 'usd',
               product_data: {
                 name: 'AI Trainer Hub — Lifetime Application Fee',
               },
               unit_amount: 1500, // $15.00
             },
             quantity: 1,
           }],
           customer_email: email,
           success_url: 'https://yourdomain.com/success',
           cancel_url:  'https://yourdomain.com/cancel',
           metadata: { fullName, phone, role },
         });
         res.json({ url: session.url });
       ========================================================= */
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (isSubmitting) return;

      clearMessage();

      // Validate
      if (!validateForm()) {
        showMessage('Please correct the highlighted fields and try again.', 'error');
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      isSubmitting = true;
      payBtn.disabled = true;
      payBtn.textContent = 'Redirecting to secure checkout…';

      const payload = {
        fullName: fullNameEl.value.trim(),
        email:    emailEl.value.trim(),
        phone:    phoneEl.value.trim(),
        role:     roleEl.value
      };

      try {
        /* ───────────────────────────────────────────────────
           PRODUCTION: replace the demo block below with:

           const res = await fetch('/api/create-checkout-session', {
             method: 'POST',
             headers: { 'Content-Type': 'application/json' },
             body: JSON.stringify(payload)
           });

           if (!res.ok) throw new Error('Checkout session failed');

           const data = await res.json();
           if (!data.url) throw new Error('Missing checkout URL');

           window.location.href = data.url;
           return;
           ─────────────────────────────────────────────────── */

        // ---- DEMO SIMULATION (front-end only) ----
        await new Promise((resolve) => setTimeout(resolve, 1400));

        showMessage(
          `✅ Thanks, ${payload.fullName}! Your application for “${payload.role}” ` +
          `has been received. You would now be redirected to Stripe to pay the ` +
          `$15 lifetime fee. (Demo mode — no real charge was made.)`,
          'success'
        );

        showToast('Application submitted successfully!');
        form.reset();
        [fullNameEl, emailEl, phoneEl, roleEl].forEach((el) => {
          el.removeAttribute('aria-invalid');
        });
        roleEl.value = '';
      } catch (err) {
        console.error(err);
        showMessage('Something went wrong. Please try again.', 'error');
      } finally {
        isSubmitting = false;
        payBtn.disabled = false;
        payBtn.textContent = 'Pay $15 & submit application';
      }
    });

    /* =========================================================
       8. LIVE VALIDATION (clear errors on input)
       ========================================================= */
    [fullNameEl, emailEl, phoneEl, roleEl].forEach((el) => {
      const evt = el.tagName === 'SELECT' ? 'change' : 'input';
      el.addEventListener(evt, () => {
        el.removeAttribute('aria-invalid');
        if (formMsg.classList.contains('error')) clearMessage();
      });
    });
  </script>
</body>
</html>
